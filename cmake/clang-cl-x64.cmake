# Cross compile with Microsoft's CRT/SDK (prepared by xwin), not MinGW.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(POCKET_LLVM_ROOT "/workspace/windows-tools/root/usr/lib/llvm-19" CACHE PATH "LLVM tools root")
set(POCKET_MSVC_SDK "/workspace/windows-tools/msvc-sdk" CACHE PATH "xwin SDK root")
set(CMAKE_C_COMPILER "${POCKET_LLVM_ROOT}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${POCKET_LLVM_ROOT}/bin/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER "${POCKET_LLVM_ROOT}/bin/lld-link")
set(CMAKE_RC_COMPILER "${POCKET_LLVM_ROOT}/bin/llvm-rc")
set(CMAKE_MT "${POCKET_LLVM_ROOT}/bin/llvm-mt")
set(_includes "/imsvc${POCKET_MSVC_SDK}/crt/include /imsvc${POCKET_MSVC_SDK}/sdk/include/ucrt /imsvc${POCKET_MSVC_SDK}/sdk/include/um /imsvc${POCKET_MSVC_SDK}/sdk/include/shared")
set(CMAKE_C_FLAGS_INIT "${_includes}")
set(CMAKE_CXX_FLAGS_INIT "${_includes}")
set(_libs "/libpath:${POCKET_MSVC_SDK}/crt/lib/x86_64 /libpath:${POCKET_MSVC_SDK}/sdk/lib/ucrt/x86_64 /libpath:${POCKET_MSVC_SDK}/sdk/lib/um/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_libs} /manifest:no")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_libs} /manifest:no")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_libs} /manifest:no")
set(CMAKE_RC_FLAGS_INIT "/I${POCKET_MSVC_SDK}/sdk/include/um /I${POCKET_MSVC_SDK}/sdk/include/shared")
