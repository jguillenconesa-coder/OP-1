// SPDX-License-Identifier: AGPL-3.0-only
// Own caller for the complete original tuning-index setter.
.include "testutils.inc"
start
imm32 SP, 0x03000000
P4.H = inputs;
P4.L = inputs;
P5.H = results;
P5.L = results;
record_loop:
R0 = [P4];
CC = BITTST(R0,0);
IF !CC JUMP preserve_neighbors;
P1 = P4;
P1 += 12;
imm32 P2, 0x018c217c
P3 = 4;
LSETUP(image_in,image_in_end) LC0 = P3;
image_in: R0 = [P1++];
image_in_end: [P2++] = R0;
preserve_neighbors:
R0 = [P4 + 4];
R1 = [P4 + 8];
imm32 P0, 0x01a842f0
CALL (P0);
imm32 P1, 0x018c217c
P2 = P5;
P3 = 4;
LSETUP(image_out,image_out_end) LC0 = P3;
image_out: R0 = [P1++];
image_out_end: [P2++] = R0;
P5 = P2;
P4 += 32;
R0 = P4;
R1.H = inputs_end;
R1.L = inputs_end;
CC = R0 == R1;
IF !CC JUMP record_loop;
R0.H = result_args;
R0.L = result_args;
P0 = 5;
EXCPT 0;
exit 0
.data
.align 4
result_args: .long 1,results,@BYTES@
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin"
