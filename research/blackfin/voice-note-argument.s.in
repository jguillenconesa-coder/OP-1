// SPDX-License-Identifier: AGPL-3.0-only
// Own isolated caller. Argument destination and globals are explicit; no dispatcher.
.include "testutils.inc"
start
imm32 SP, 0x03000000
P4.H = inputs;
P4.L = inputs;
P5.H = results;
P5.L = results;
record_loop:
R0 = [P4];
CC = BITTST(R0,0);
IF !CC JUMP argument_retained;
P1 = P4;
P1 += 16;
P2.H = argument_area;
P2.L = argument_area;
P3 = 16;
LSETUP(argument_in,argument_in_end) LC0 = P3;
argument_in: R0 = [P1++];
argument_in_end: [P2++] = R0;
argument_retained:
@LOAD@
R0.H = argument_area;
R0.L = argument_area;
R0 += 16;
R3 = [P4+12];
R0 = R0 + R3;
R1 = [P4+4];
R2 = [P4+8];
imm32 P0, 0x01a85014
CALL (P0);
P1.H = argument_area;
P1.L = argument_area;
P2 = P5;
P3 = 16;
LSETUP(argument_out,argument_out_end) LC0 = P3;
argument_out: R0 = [P1++];
argument_out_end: [P2++] = R0;
@SAVE@
P5 = P2;
P0 = @RECORD@;
P4 = P4 + P0;
R0 = P4;
R1.H = inputs_end;
R1.L = inputs_end;
CC = R0 == R1;
IF CC JUMP records_done;
JUMP.L record_loop;
records_done:
R0.H = result_args;
R0.L = result_args;
P0 = 5;
EXCPT 0;
exit 0
.data
.align 4
argument_area: .space 64
result_args: .long 1,results,@BYTES@
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin", 0, 0x00a85014
.global voice246_note_argument
.type voice246_note_argument, STT_FUNC
voice246_note_argument:
.incbin "@WORK@/sdram.bin", 0x00a85014, 0x44
.size voice246_note_argument, .-voice246_note_argument
.incbin "@WORK@/sdram.bin", 0x00a85058
