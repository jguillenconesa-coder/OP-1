.include "testutils.inc"
start
imm32 SP, 0x03000000
P0.H = inputs;
P0.L = inputs;
P1.H = control_ptr;
P1.L = control_ptr;
[P1] = P0;
P0.H = results;
P0.L = results;
P1.H = output_ptr;
P1.L = output_ptr;
[P1] = P0;
probe_loop:
P0.H = control_ptr;
P0.L = control_ptr;
P1 = [P0];
P2.H = state;
P2.L = state;
R0 = [P1+644];
CC = R0 == 0;
IF CC JUMP setup_increment;
R0 = P2;
P0.H = pd_reset;
P0.L = pd_reset;
CALL (P0);
P2.H = state;
P2.L = state;
P0.H = control_ptr;
P0.L = control_ptr;
P1 = [P0];
setup_increment:
P3 = 132;
P3 = P1 + P3;
imm32 P4, 0xff801950
P0 = 128;
LSETUP(fill_start,fill_end) LC0 = P0;
fill_start:
R0 = [P3++];
fill_end: [P4++] = R0;
P0.H = output_ptr;
P0.L = output_ptr;
R0 = [P0];
R1 = R0;
R0 = P2;
R2 = P1;
P0.H = render;
P0.L = render;
CALL (P0);
P0.H = output_ptr;
P0.L = output_ptr;
R0 = [P0];
P1 = R0;
P2.H = state;
P2.L = state;
R1 = [P2+4];
[P1+256] = R1;
R1 = [P2+12];
[P1+260] = R1;
R1 = [P2+24];
[P1+264] = R1;
R1 = B[P2+20] (Z);
[P1+268] = R1;
R1 = 272 (X);
R0 = R0 + R1;
[P0] = R0;
P0.H = control_ptr;
P0.L = control_ptr;
R0 = [P0];
R1 = 648 (X);
R0 = R0 + R1;
[P0] = R0;
P1.H = inputs_end;
P1.L = inputs_end;
R1 = P1;
CC = R0 == R1;
IF !CC JUMP probe_loop;
P0.H = io_args;
P0.L = io_args;
R0 = P0;
P0 = 5;
EXCPT 0;
exit 0
.set pd_reset, render + 550
render:
.incbin "@WORK@/pd-full-probe/kernel.bin"
.data
.align 4
io_args: .long 1,results,626688
control_ptr: .long 0
output_ptr: .long 0
state: .space 28
inputs: .incbin "@WORK@/pd-stream-probe/inputs.bin"
inputs_end:
results: .space 626688
.section .table,"a"
.incbin "@WORK@/pd-full-probe/table.bin"
