// SPDX-License-Identifier: AGPL-3.0-only
// Own instrument-only release dispatcher caller. Empty map, no audio render.
.include "testutils.inc"
start
imm32 SP, 0x03000000
CALL original_note_copy;
CALL own_frame_probe;
P0.H = local_pointer;
P0.L = local_pointer;
[P0] = R0;
R0.H = prefix_args;
R0.L = prefix_args;
P0 = 5;
EXCPT 0;
R0.H = note_args;
R0.L = note_args;
P0 = 5;
EXCPT 0;
P4.H = inputs;
P4.L = inputs;
P5.H = results;
P5.L = results;
record_loop:
@LOAD@
P1 = P4;
P1 += 8;
P2.H = argument_area;
P2.L = argument_area;
P3 = 8;
LSETUP(argument_in,argument_in_end) LC0 = P3;
argument_in: R0 = [P1++];
argument_in_end: [P2++] = R0;
P0.H = local_pointer;
P0.L = local_pointer;
P2 = [P0];
P3 = 4;
LSETUP(local_in,local_in_end) LC0 = P3;
local_in: R0 = [P1++];
local_in_end: [P2++] = R0;
R0.H = argument_area;
R0.L = argument_area;
R0 += 8;
imm32 P0, 0x01a85840
CALL (P0);
@SAVE@
P1.H = argument_area;
P1.L = argument_area;
P3 = 8;
LSETUP(argument_out,argument_out_end) LC0 = P3;
argument_out: R0 = [P1++];
argument_out_end: [P2++] = R0;
P0.H = local_pointer;
P0.L = local_pointer;
P1 = [P0];
P3 = 4;
LSETUP(local_out,local_out_end) LC0 = P3;
local_out: R0 = [P1++];
local_out_end: [P2++] = R0;
P5 = P2;
P0 = @RECORD@;
P4 = P4 + P0;
R0 = P4;
R1.H = inputs_end;
R1.L = inputs_end;
CC = R0 == R1;
IF CC JUMP done;
JUMP.L record_loop;
done:
R0.H = args;
R0.L = args;
P0 = 5;
EXCPT 0;
R0.H = note_args;
R0.L = note_args;
P0 = 5;
EXCPT 0;
exit 0
own_frame_probe:
LINK 0x20;
R0 = FP;
R0 += -16;
UNLINK;
RTS;
.align 4
original_note_copy:
.incbin "@WORK@/sdram.bin", 0x00a86700, 0x2e
RTS;
.data
.align 4
local_pointer: .long 0
prefix_args: .long 1,local_pointer,4
note_args: .long 1,0x01dfe530,512
args: .long 1,results,@BYTES@
argument_area: .space 32
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin", 0, 0x009e2dc0
.global empty_map_notification
.type empty_map_notification, STT_FUNC
empty_map_notification:
.incbin "@WORK@/sdram.bin", 0x009e2dc0, 0xa2
.size empty_map_notification, .-empty_map_notification
.incbin "@WORK@/sdram.bin", 0x009e2e62, 0x000a29de
.global instrument_release_dispatch
.type instrument_release_dispatch, STT_FUNC
instrument_release_dispatch:
.incbin "@WORK@/sdram.bin", 0x00a85840, 0x96
.size instrument_release_dispatch, .-instrument_release_dispatch
.incbin "@WORK@/sdram.bin", 0x00a858d6
