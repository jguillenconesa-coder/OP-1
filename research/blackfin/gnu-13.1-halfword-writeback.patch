Apply AFTER gnu-13.1-dreg-writeback.patch. Local GNU GDB 13.1 research fix.
Limited to disjoint halfword loads (LDSTpmod/dspLDST); no firmware changes.

--- a/sim/bfin/bfin-sim.c
+++ b/sim/bfin/bfin-sim.c
@@ -559,0 +560,17 @@
+
+/* Merge disjoint halfword writes in the pending queue, never in the
+   architectural register file used by other slots of the packet. */
+static void
+queue_dreg_half (SIM_CPU *cpu, int reg, bu32 val, bu32 mask)
+{
+  int i;
+  bu32 *addr = &DREG (reg);
+  for (i = BFIN_CPU_STATE.n_stores - 1; i >= 0; --i)
+    if (BFIN_CPU_STATE.stores[i].addr == addr)
+      {
+        struct store *s = &BFIN_CPU_STATE.stores[i];
+        s->val = (s->val & ~mask) | (val & mask);
+        return;
+      }
+  STORE (DREG (reg), (DREG (reg) & ~mask) | (val & mask));
+}
